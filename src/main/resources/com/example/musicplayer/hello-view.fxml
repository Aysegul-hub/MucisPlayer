<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.example.musicplayer.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="MUSIC PLAYER" />
   <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
   <Label fx:id="songTitleLabel" text="Şarkı Adı" />
   <Label fx:id="artistLabel" text="Sanatçı" />
   <Slider fx:id="progressSlider" />
   <Label fx:id="currentTimeLabel" text="Geçen Süre" />
   <Label fx:id="totalTimeLabel" text="Toplam Süre" />
   <Button fx:id="previousButton" mnemonicParsing="false" onAction="#previousSong" text="Önceki" />
   <Button fx:id="playPauseButton" mnemonicParsing="false" onAction="#playPause" text="Play/Pause" />
   <Button fx:id="nextButton" mnemonicParsing="false" onAction="#nextSong" text="Sonraki" />
   <Slider fx:id="volumeSlider" />
</VBox>
